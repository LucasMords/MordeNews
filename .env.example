# Copie para .env e preencha. O .env nunca vai para o git.

# Supabase — Project Settings > API (URL do projeto e chave secreta / service_role)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # só no backend/GitHub Secrets, NUNCA no portal

# Contato que vai no User-Agent dos coletores, ex.: seu-email+radar@gmail.com
# Fica fora do código porque o repositório é público. Opcional.
RADAR_CONTATO=

# Gemini (bloco 2) — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # estável, gratuito; os Flash maiores davam 503/504 por sobrecarga (2026-11-18)

# E-mail do resumo diário (bloco 3) — Gmail dedicado ao projeto
# Precisa de verificação em 2 etapas ativa; a senha é uma "senha de app"
# (myaccount.google.com → Segurança → Senhas de app), NUNCA a senha da conta.
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_DESTINO=                  # quem recebe o resumo (pode ser seu e-mail pessoal)
# SMTP_HOST=smtp.gmail.com      # opcionais; estes são os padrões
# SMTP_PORTA=465

# Resumo diário: nota mínima (0–10) para entrar e máximo de itens por e-mail
NOTA_MINIMA_RESUMO=6
RESUMO_MAXIMO=30
