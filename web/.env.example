# Portal (bloco 6). Copie para .env.local; na Vercel, cadastre em Settings → Environment Variables.
# Só a URL e a chave PÚBLICA (anon ou publishable). NUNCA a service role key aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: nome na saudação ("Bom dia, Fulano!"). Sem ele, usa a parte do e-mail antes do @.
NOME_USUARIO=
